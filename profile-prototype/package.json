    "test:wheel": "node --experimental-strip-types tests/wheel-track.test.mjs"
  },
  "dependencies": {
    "@kitlangton/rolling-number": "0.4.1",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "^0.183.2",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.183.1",
    "typescript": "^7.0.2"
  }
}
